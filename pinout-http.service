[Unit]
Description=HTTP: Raspberry Pi HAT pinout (static files, port 80)
After=network.target

[Service]
Type=simple
User=r
Group=r
WorkingDirectory=/home/r/pinout
ExecStart=/usr/bin/python3 -m http.server 80 --bind 0.0.0.0 --directory /home/r/pinout
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
